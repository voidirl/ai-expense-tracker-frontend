# Copy to .env and adjust per environment. Never commit .env.

# --- Smart Expense Tracker frontend ---------------------------------------
# Both services default to same-origin paths that a dev/Docker proxy forwards.
# Only override these when there is no proxy in front of the app (e.g. Vercel),
# in which case they must be absolute.

# Base URL for the Spring Boot backend, without a trailing slash.
#   dev / docker : "/api"  -> proxied to the backend container
#   vercel       : "https://<backend>.onrender.com/api"
VITE_API_URL=/api

# Base URL for the Python/FastAPI AI advisor service.
#   dev / docker : "/ai-api" -> proxied to the ai-service container
#   vercel       : "https://<ai-service>.onrender.com"
VITE_AI_URL=/ai-api

# --- Dev-server proxy targets (ignored in production builds) -------------
# Where `npm run dev` forwards /api and /ai-api respectively.
VITE_DEV_PROXY_TARGET=http://localhost:8080
VITE_DEV_AI_PROXY_TARGET=http://localhost:8000

# Vercel example:
# VITE_API_URL=https://expense-tracker-backend-akd3.onrender.com/api
# VITE_AI_URL=https://expense-tracker-ai-service.onrender.com